---
import { Image } from 'astro:assets';
import logoHeader from '../../assets/brands/iquiclown-logo-header.png';
import logoFooter from '../../assets/brands/iquiclown-logo-footer.png';

/**
 * Logotipo oficial de Iquiclown. El enlace que lo contiene aporta el nombre accesible,
 * por eso la imagen es decorativa (alt vacío).
 * - header: logotipo rojo con nariz brillante, para fondos claros.
 * - footer: versión con «Iqui» en tono crema, para fondos oscuros.
 */
interface Props {
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
const src = variant === 'footer' ? logoFooter : logoHeader;
---

<Image class:list={['logo', variant]} {src} alt="" width={360} densities={[1, 2]} loading="eager" />

<style>
  .logo {
    width: auto;
    height: 3rem;
  }
  .logo.footer {
    height: clamp(3rem, 6vw, 4.25rem);
  }
</style>
