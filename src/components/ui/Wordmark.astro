---
/** Marca tipográfica temporal. No es un logotipo oficial. */
interface Props {
  light?: boolean;
  large?: boolean;
}
const { light = false, large = false } = Astro.props;
---

<span class:list={['wordmark', { light, large }]} aria-hidden="true"><span class="a">IQUI</span><span class="b">CLOWN</span></span>

<style>
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.85rem;
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .wordmark.large {
    font-size: clamp(2.5rem, 6vw, 4rem);
  }
  .a {
    color: var(--green);
  }
  .b {
    color: var(--coral-deep);
  }
  .light .a {
    color: var(--cream);
  }
  .light .b {
    color: var(--coral);
  }
</style>
