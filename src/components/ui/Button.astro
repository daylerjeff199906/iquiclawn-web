---
interface Props {
  href: string;
  variant?: 'primary' | 'accent' | 'outline' | 'light' | 'ink';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', arrow = false, class: className } = Astro.props;
---

<a href={href} class:list={['btn', `btn--${variant}`, className]}>
  <slot />
  {
    arrow && (
      <svg class="arrow" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <path d="M4 14 14 4M6 4h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0.7rem 1.35rem;
    border: 2px solid transparent;
    border-radius: var(--radius-btn);
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn:active {
    transform: translateY(0);
  }
  .arrow {
    transition: transform var(--dur) var(--ease);
  }
  .btn:hover .arrow {
    transform: translate(2px, -2px);
  }

  .btn--primary {
    background: var(--green);
    color: var(--cream);
  }
  .btn--primary:hover {
    background: var(--green-deep);
    color: var(--cream);
  }

  .btn--accent {
    background: var(--coral-deep);
    color: var(--white);
  }
  .btn--accent:hover {
    background: var(--coral-darker);
    color: var(--white);
  }

  .btn--ink {
    background: var(--ink);
    color: var(--cream);
  }
  .btn--ink:hover {
    background: #000;
    color: var(--cream);
  }

  .btn--outline {
    border-color: currentColor;
    color: var(--text);
    background: transparent;
  }
  .btn--outline:hover {
    background: var(--text);
    border-color: var(--text);
    color: var(--on-text);
  }

  .btn--light {
    background: var(--yellow);
    color: var(--ink);
  }
  .btn--light:hover {
    background: var(--yellow-soft);
    color: var(--ink);
  }
</style>
