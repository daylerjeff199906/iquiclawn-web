---
interface Props {
  title: string;
  text: string;
}
const { title, text } = Astro.props;
---

<div class="empty">
  <svg class="art" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
    <circle cx="48" cy="48" r="44" fill="var(--yellow)"></circle>
    <circle cx="48" cy="44" r="14" fill="var(--coral)"></circle>
    <path d="M20 68c9-7 17-7 28 0s19 7 28 0" fill="none" stroke="var(--green)" stroke-width="5" stroke-linecap="round"></path>
  </svg>
  <div class="copy">
    <h2>{title}</h2>
    <p>{text}</p>
    <slot />
  </div>
</div>

<style>
  .empty {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: center;
    max-width: 48rem;
    padding: var(--space-6);
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
    background: var(--white);
  }
  .art {
    width: 5.5rem;
  }
  .copy {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  h2 {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    letter-spacing: -0.03em;
  }
  @media (max-width: 34rem) {
    .empty {
      grid-template-columns: 1fr;
    }
  }
</style>
