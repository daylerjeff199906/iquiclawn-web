---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  imagen: ImageMetadata;
  alt: string;
  credito?: string;
}
interface Props {
  items: Item[];
  label?: string;
}
const { items, label = 'Galería de imágenes' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="gallery" aria-label={label}>
      <ul>
        {items.map((item) => (
          <li>
            <figure>
              <Image src={item.imagen} alt={item.alt} widths={[360, 640, 960]} sizes="(min-width: 52rem) 33vw, 100vw" loading="lazy" />
              {item.credito && <figcaption>Foto: {item.credito}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  ul {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  figure {
    margin: 0;
  }
  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
</style>
