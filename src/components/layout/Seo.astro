---
import { organization } from '../../data/organization';

interface Props {
  title: string;
  description: string;
  /** Imagen Open Graph (URL absoluta o ruta del sitio). Solo si existe una imagen autorizada. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  /** Datos estructurados ya validados (JSON-LD). */
  jsonLd?: Record<string, unknown>;
}

const { title, description, image, type = 'website', noindex = false, publishedTime, jsonLd } = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? `${organization.name} | ${organization.tagline}` : `${title} | ${organization.name}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={organization.name} />
<meta property="og:locale" content="es_PE" />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
