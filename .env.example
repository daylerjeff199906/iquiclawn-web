# Dominio de producción (sin barra final). Activa canonical, sitemap y URLs absolutas.
# PUBLIC_SITE_URL=https://ejemplo.org

# Endpoint real del formulario de contacto (por ejemplo, un formulario de Formspree).
# Mientras esté vacío, el sitio NO muestra el formulario como operativo.
# PUBLIC_CONTACT_ENDPOINT=

# Correo de contacto confirmado por la organización (opcional).
# PUBLIC_CONTACT_EMAIL=
